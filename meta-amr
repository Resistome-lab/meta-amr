#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# --- Default Parameters ---
THREADS=8
CARD_DB="$HOME/CARD"
SRR_ID=""
OUTPUT_DIR="meta_amr_output"
BOWTIE2_INDEX=""

# --- Helper Functions ---
usage() {
    cat << EOF
Usage: meta-amr -s <SRR_ACCESSION> [-d <CARD_DB_PATH>] [-i <BOWTIE2_INDEX>] [-t <THREADS>] [-o <OUTPUT_DIR>]

An automated CLI pipeline for downloading SRA metagenomic datasets, 
aligning against reference genomes, and quantifying AMR gene abundances using CARD and DIAMOND.

Options:
  -s  SRA accession number (Required, e.g., SRR39779725)
  -d  Path to DIAMOND CARD database (Default: ~/CARD)
  -i  Path to Bowtie2 host reference index prefix (Optional; pass "NONE" or skip if no filtering needed)
  -t  Number of CPU threads (Default: 8)
  -o  Output directory path (Default: meta_amr_output)
  -h  Display this help message and exit
EOF
    exit 1
}

# --- Check Mandatory Dependencies ---
check_dependencies() {
    local deps=("prefetch" "reformat.sh" "diamond" "awk")
    for tool in "${deps[@]}"; do
        if ! command -v "$tool" &> /dev/null; then
            echo "[ERROR] Required dependency '$tool' is not installed or not in PATH." >&2
            exit 1
        fi
    done

    if ! command -v fasterq-dump &> /dev/null && ! command -v fastq-dump &> /dev/null; then
        echo "[ERROR] Neither fasterq-dump nor fastq-dump was found in PATH." >&2
        exit 1
    fi
}

# --- Parse Command Line Arguments ---
while getopts "s:d:i:t:o:h" opt; do
  case ${opt} in
    s ) SRR_ID="$OPTARG" ;;
    d ) CARD_DB="$OPTARG" ;;
    i ) BOWTIE2_INDEX="$OPTARG" ;;
    t ) THREADS="$OPTARG" ;;
    o ) OUTPUT_DIR="$OPTARG" ;;
    h ) usage ;;
    \? ) usage ;;
  esac
done

if [ -z "$SRR_ID" ]; then
    echo "[ERROR] Option -s <SRR_ACCESSION> is required." >&2
    usage
fi

# Validate threads parameter
if ! [[ "$THREADS" =~ ^[0-9]+$ ]]; then
    THREADS=8
fi

# --- Main Execution Flow ---
check_dependencies

mkdir -p "${OUTPUT_DIR}"
cd "${OUTPUT_DIR}"

echo "=================================================="
echo " Starting Meta-AMR Pipeline for: ${SRR_ID}"
echo " Threads: ${THREADS}"
echo " Database: ${CARD_DB}"
echo " Bowtie2 Index: ${BOWTIE2_INDEX:-None (Direct to DIAMOND)}"
echo " Output Dir: $(pwd)"
echo "=================================================="

# Step 1: Fetch raw data directly into active working directory
echo "[1/7] Downloading SRA accession (${SRR_ID})..."
prefetch "${SRR_ID}" --output-directory .

# Step 2: Convert SRA to FASTQ
echo "[2/7] Extracting FASTQ files for ${SRR_ID}..."
mkdir -p fastq_tmp

SRA_FILE="${SRR_ID}/${SRR_ID}.sra"

if [ ! -f "${SRA_FILE}" ]; then
    SRA_FILE="${SRR_ID}"
fi

if command -v fasterq-dump &> /dev/null; then
    fasterq-dump "${SRA_FILE}" --outdir fastq_tmp --split-files --threads "${THREADS}" -p
else
    fastq-dump "${SRA_FILE}" --outdir fastq_tmp --split-files
fi

# Step 3: Check for paired vs single end and interleave
echo "[3/7] Processing extracted FASTQ files..."

FWD="fastq_tmp/${SRR_ID}_1.fastq"
REV="fastq_tmp/${SRR_ID}_2.fastq"
SINGLE="fastq_tmp/${SRR_ID}.fastq"

if [ -f "$FWD" ] && [ -f "$REV" ]; then
    echo "--> Detected paired-end reads. Interleaving..."
    reformat.sh in1="$FWD" in2="$REV" out="interleaved_${SRR_ID}.fq.gz" overwrite=true
elif [ -f "$SINGLE" ]; then
    echo "--> Detected single-end reads. Compressing..."
    gzip -c "$SINGLE" > "interleaved_${SRR_ID}.fq.gz"
else
    echo "[ERROR] FASTQ extraction failed to produce valid read files!" >&2
    exit 1
fi

INPUT_FOR_DIAMOND="interleaved_${SRR_ID}.fq.gz"

# Step 4, 5, 6: Bowtie2 Host Filtering (Optional)
if [ -n "${BOWTIE2_INDEX}" ] && [ "${BOWTIE2_INDEX}" != "NONE" ]; then
    echo "[4/7] Aligning interleaved reads with Bowtie2 (${BOWTIE2_INDEX})..."
    
    if ! command -v bowtie2 &> /dev/null || ! command -v samtools &> /dev/null || ! command -v bedtools &> /dev/null; then
        echo "[ERROR] Host filtering requires bowtie2, samtools, and bedtools to be installed." >&2
        exit 1
    fi

    if ! ls "${BOWTIE2_INDEX}"*.bt2* &> /dev/null; then
        echo "[ERROR] Bowtie2 index '${BOWTIE2_INDEX}' was not found!" >&2
        exit 1
    fi

    bowtie2 -x "${BOWTIE2_INDEX}" -U "interleaved_${SRR_ID}.fq.gz" -S "aligned_${SRR_ID}.sam" -p "${THREADS}"

    echo "[5/7] Sorting SAM and converting to BAM..."
    samtools view -bS "aligned_${SRR_ID}.sam" | samtools sort - -o "sorted_${SRR_ID}.bam" -@ "${THREADS}"
    samtools index "sorted_${SRR_ID}.bam"

    echo "[6/7] Extracting aligned reads to FASTQ..."
    bedtools bamtofastq -i "sorted_${SRR_ID}.bam" -fq "host_filtered_${SRR_ID}.fastq.gz"
    INPUT_FOR_DIAMOND="host_filtered_${SRR_ID}.fastq.gz"
else
    echo "[4-6/7] Skipping Bowtie2 host alignment. Passing raw interleaved reads directly to DIAMOND."
fi

# Step 7: DIAMOND Search & Gene Counting
echo "[7/7] Profiling AMR target genes using DIAMOND & AWK..."
blast_results="diamond_${SRR_ID}.m8"
AWK_results="awk_diamond_${SRR_ID}.tsv"

diamond blastx -d "${CARD_DB}" -q "${INPUT_FOR_DIAMOND}" -o "${blast_results}" -k 1 -f 6 -p "${THREADS}"

awk 'BEGIN { 
    OFS="\t"; 
    print "Query ID\tSubject ID\tPercentage of identical matches\tAlignment length\tNumber of mismatches\tNumber of gap openings\tStart of alignment in query\tEnd of alignment in query\tStart of alignment in subject\tEnd of alignment in subject\tExpected value\tBit score\tGene_Count" 
} 
{ 
    gene = $2;

    # Extract clean gene name without corrupting original $2 string
    if (gene ~ /ARO_Name:/) {
        sub(/.*ARO_Name:/, "", gene);
        sub(/\|.*/, "", gene);
    } 
    else if (gene ~ /\|/) {
        n = split(gene, parts, "|");
        gene = parts[n];
    }

    gene_count[gene]++;

    # Output original fields intact plus gene count
    print $0, gene_count[gene];
} 
END { 
    for (g in gene_count) { 
        print g, gene_count[g] > "unique_gene_sums.txt" 
    } 
}' "${blast_results}" > "${AWK_results}"

echo "=================================================="
echo " Pipeline Finished Successfully!"
echo " Results Summary: ${OUTPUT_DIR}/${AWK_results}"
echo " Unique Gene Counts: ${OUTPUT_DIR}/unique_gene_sums.txt"
echo "=================================================="
